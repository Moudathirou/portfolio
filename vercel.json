{
    "version": 2,
    "builds": [
        {
            "src": "backend/main.py",
            "use": "@vercel/python"
        },
        {
            "src": "frontend/src/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "backend/main.py"
        },
        {
            "src": "/main.js",
            "dest": "/frontend/src/main.js"
        },
        {
            "src": "/styles.css",
            "dest": "/frontend/src/styles.css"
        },
        {
            "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico))",
            "dest": "7frontend/src/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/frontend/src/index.html"
        }

        
    ]
}
